# 复制为 .env 后修改；.env 不入 git 不入库
# ── 数据库 ──────────────────────────────
KB_DB_PASSWORD=ChangeMe_MySql_2026

# ── JWT 密钥（≥32 位随机串，泄露等于所有人可伪造登录）──
KB_JWT_SECRET=ChangeMe_Random_32_Chars_Minimum_Secret

# ── MinIO ──────────────────────────────
KB_MINIO_ACCESS_KEY=ChangeMe_AccessKey
KB_MINIO_SECRET_KEY=ChangeMe_SecretKey

# ── LDAP（找系统工程师要这四项，留空则只支持本地账号登录）──
# 例：ldap://ad.corp.com:389
KB_LDAP_URL=
# 例：DC=corp,DC=com
KB_LDAP_BASE_DN=
# DN 模板，二选一（按公司 AD 结构）：
#   uid={0},ou=people,DC=corp,DC=com
KB_LDAP_USER_DN_PATTERN=uid={0},ou=people
# 或 UPN 模式：{0}@corp.com
KB_LDAP_UPN_PATTERN=

# ── Web 端口（默认 80，被占用时改 8081 等）──
KB_WEB_PORT=80
